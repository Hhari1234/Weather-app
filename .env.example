# Copy this file to `.env` (or export the variables in your shell) and fill in
# your real key. `.env` is git-ignored - never commit real API keys.

# Get a free key at https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key

# HTTP port (defaults to 8080 locally; Render provides this automatically)
PORT=8080
